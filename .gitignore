# ROS 2 and C++ Workspace .gitignore
# Build, install, and log directories
build/
install/
log/

# ROS 2 colcon files
*.pyc
*.pyo
*.pyd
*.so
*.swp
*.swo
*.swn
*.bak
*.tmp
*.log
*.DS_Store
*.egg-info/

# CMake and Make
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
CTest*

# Fairino SDK generated outputs
fairino-cpp-sdk/libfairino/LinuxBuild/bin/
fairino-cpp-sdk/libfairino/build*/
fairino-cpp-sdk/libfairino/lib/
fairino-cpp-sdk/libfairino/include/
fairino-cpp-sdk/linux/libfairino/lib/
fairino-cpp-sdk/windows/libfairino/lib/
*.so.*

# Python cache
__pycache__/

# VS Code
.vscode/

# Misc
*.user
*.~
*.orig
*.rej
*.bin
*.out
*.obj
*.exe
*.dll
*.class
*.jar
*.zip
*.tar
*.gz
*.7z
*.csv
*.tsv
*.db
*.sqlite
*.pdf
*.doc*
*.xls*
*.ppt*
*.mp3
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.ico

# Ignore hidden files except .gitignore
.*
!.gitignore

# Audio fusion pipeline (dracoviloc_audio_fusion): the trt_env venv and the
# AST TensorRT engine are machine-specific and not portable between Jetsons.
/trt_env/
/gre_env/
src/dracoviloc_audio_fusion/models/*.engine

# Centralized local model artifacts. The README is tracked, while weights,
# portable exports, and machine-specific TensorRT engines remain local.
/models/*
!/models/README.md

# Isaac ROS deployment artifacts. Keep the portable model and regression video
# in DracoViLoc; generate TensorRT engines and Python environments per target.
!isaac_ros/media/
!isaac_ros/media/drone-video1.mp4
!isaac_ros/models/
!isaac_ros/models/drone_yolo11n_best.pt
!isaac_ros/models/drone_yolo11n_best.onnx
isaac_ros/models/*.plan
isaac_ros/models/yolo/
isaac_ros/models/*_engine/
isaac_ros/results/
src/vicoman_vision/realsense-ros/
