# CMake and Make
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
CTest*

# Fairino SDK generated outputs
fairino-cpp-sdk/libfairino/LinuxBuild/bin/
fairino-cpp-sdk/libfairino/build*/
fairino-cpp-sdk/libfairino/lib/
fairino-cpp-sdk/libfairino/include/
fairino-cpp-sdk/linux/libfairino/lib/
fairino-cpp-sdk/windows/libfairino/lib/
*.so.*

# Python cache
__pycache__/

# VS Code
.vscode/

