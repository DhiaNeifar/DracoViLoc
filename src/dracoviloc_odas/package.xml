<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dracoviloc_odas</name>
  <version>0.1.0</version>
  <description>Self-contained UMA16v2 and ODAS integration for DracoViLoc.</description>
  <maintainer email="maintainer@example.com">DracoViLoc maintainers</maintainer>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>audio_utils_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>odas_ros</exec_depend>
  <exec_depend>odas_ros_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
