<?xml version="1.0"?>
<package format="3">
  <name>dracoviloc_drone</name>
  <version>0.1.0</version>
  <description>Kinematic ground-truth drone model and keyboard control.</description>
  <maintainer email="maintainer@example.com">DracoViLoc</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>ignition-msgs8</depend>
  <depend>ignition-transport11</depend>
