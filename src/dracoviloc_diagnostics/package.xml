<?xml version="1.0"?>
<package format="3">
  <name>dracoviloc_diagnostics</name>
  <version>0.1.0</version>
  <description>Event timing and end-effector kinematics logging for diagnosing arm_tracking behavior, plus a live plot.</description>
  <maintainer email="maintainer@example.com">DracoViLoc</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
