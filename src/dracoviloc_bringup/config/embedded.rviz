# Control center 3D view: robot, grid and the direction arrows only.
# Arrows come from direction_marker_visualizer on /dracoviloc/arrows; the
# GUI shows/hides each source with its show_<name> parameter.
Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 12
      Color: 70; 90; 105
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Name: Cobots
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic:
        Depth: 50
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dracoviloc/arrows
      Name: Direction arrows
      Value: true
  Enabled: true
  Global Options:
    Background Color: 11; 17; 24
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.2
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.6
      Name: Current View
      Pitch: 0.45
      Target Frame: world
      Yaw: -0.8
Window Geometry:
  Height: 600
  Width: 900
  Hide Left Dock: true
  Hide Right Dock: true
