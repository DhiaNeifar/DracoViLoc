<?xml version="1.0"?>
<package format="3">
  <name>dracoviloc_mobilenetv2</name>
  <version>0.1.0</version>
  <description>MobileNetV2 classification of ODAS audio with optional direction fusion.</description>
  <maintainer email="maintainer@example.com">DracoViLoc</maintainer>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>audio_utils_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>odas_ros_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
